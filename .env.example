# MiniDesk 环境变量样例
# 复制为本地 .env.local 使用，或按需导出到进程环境；Spring Boot 不会自动读取 .env 文件。
# 本文件只是变量清单，不含任何真实凭据，也不要把真实凭据写回仓库。

# ===== 后端（运行期）=====

# JWT 签名密钥：生产必须替换，建议 `openssl rand -hex 32` 生成
SA_TOKEN_SECRET=replace-with-a-long-random-string

# 首个注册者的管理员领取令牌：公网部署强烈建议设置，留空表示不校验
MINIDESK_CLAIM_TOKEN=

# 数据源：默认不需要设置。主库 URL 已跟随 MINIDESK_DATA_DIR，
# 单独设置 SPRING_DATASOURCE_URL 会覆盖它，导致「数据目录」与「库文件」配置分叉。
# 确实要换库时才启用（Docker 部署切勿设置）：
# SPRING_DATASOURCE_URL=jdbc:sqlite:/data/minidesk.db

# 端口建议用命令行参数 --server.port=18080 显式指定，避免环境变量 PORT 覆盖
SERVER_PORT=18080

# 数据目录：单 Jar 部署建议写绝对路径；恢复引导在 Spring 启动前读取同一变量
MINIDESK_DATA_DIR=./data

# 可选：知识库（docs.minims.cn）访问令牌，mdt_ 开头。
# 仅在「还没有任何用户配置过知识库令牌」时于首次启动加密写入 integration_config，
# 之后不再覆盖设置页里改过的配置。也可以留空，直接在「设置 → 集成配置」里填。
MINIDESK_MINIDOCS_TOKEN=

# ===== 前端（构建期）=====
# VITE_* 会打进前端产物，属于公开内容，禁止在这里放任何密钥或令牌

VITE_APP_TITLE=极简工作台
VITE_API_BASE=/api
VITE_USE_MOCK=false
