# MiniDesk 环境变量样例
# 复制为本地 .env.local 使用，或按需导出到进程环境；Spring Boot 不会自动读取 .env 文件。
# 本文件只是变量清单，不含任何真实凭据，也不要把真实凭据写回仓库。

# ===== 后端（运行期）=====

# JWT 签名密钥：生产必须替换，建议 `openssl rand -hex 32` 生成
SA_TOKEN_SECRET=replace-with-a-long-random-string

# 首个注册者的管理员领取令牌：公网部署强烈建议设置，留空表示不校验
MINIDESK_CLAIM_TOKEN=

# 数据源：默认 SQLite，主库 URL 跟随 MINIDESK_DATA_DIR，不需要设置。
# 生产切 MySQL：Docker 部署请在 deploy/.env 里设置下面这一组 MINIDESK_DB_*；
# 裸机 java -jar 则设置 SPRING_PROFILES_ACTIVE=mysql 与 MINIDESK_MYSQL_*。
# 方言由 JDBC 元数据自动判定；凭据只放本机环境变量，绝不写回仓库或日志。
#
# MINIDESK_DB_URL=jdbc:mysql://127.0.0.1:3306/minidesk?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=utf8
# MINIDESK_DB_DRIVER=com.mysql.cj.jdbc.Driver
# MINIDESK_DB_USERNAME=minidesk
# MINIDESK_DB_PASSWORD=replace-me
# MINIDESK_DB_INIT_SQL=SET NAMES utf8mb4
# MINIDESK_DB_SCHEMA=classpath:db/schema-mysql.sql
# MINIDESK_DB_POOL_SIZE=12
#
# 裸机等价写法：
# SPRING_PROFILES_ACTIVE=mysql
# MINIDESK_MYSQL_URL=jdbc:mysql://127.0.0.1:3306/minidesk?useSSL=false&allowPublicKeyRetrieval=true
# MINIDESK_MYSQL_USERNAME=minidesk
# MINIDESK_MYSQL_PASSWORD=replace-me

# 端口建议用命令行参数 --server.port=18080 显式指定，避免环境变量 PORT 覆盖
SERVER_PORT=18080

# 数据目录：单 Jar 部署建议写绝对路径；恢复引导在 Spring 启动前读取同一变量
# 网盘使用本地存储时，文件落在 <该目录>/drive/，容器部署务必把整目录挂到持久卷
MINIDESK_DATA_DIR=./data

# 网盘的 S3 / RustFS 配置不通过环境变量注入：登录后在「网盘 → 存储设置」里填写，
# SecretKey 经 AES-GCM 加密后存数据库，接口只回显掩码。请勿把 AK/SK 写进本文件。

# 可选：知识库（docs.minims.cn）访问令牌，mdt_ 开头。
# 仅在「还没有任何用户配置过知识库令牌」时于首次启动加密写入 integration_config，
# 之后不再覆盖设置页里改过的配置。也可以留空，直接在「设置 → 集成配置」里填。
MINIDESK_MINIDOCS_TOKEN=

# 天气数据源优先级：cma（中国天气网，国内直连）/ open-meteo（Open-Meteo，CC BY 4.0）
# 两者都免费、无需 API Key；默认 cma,open-meteo，海外部署建议反过来
MINIDESK_WEATHER_PROVIDERS=cma,open-meteo

# ===== 前端（构建期）=====
# VITE_* 会打进前端产物，属于公开内容，禁止在这里放任何密钥或令牌

VITE_APP_TITLE=极简工作台
VITE_API_BASE=/api
VITE_USE_MOCK=false
