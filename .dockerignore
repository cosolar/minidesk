# 构建上下文是仓库根（Dockerfile 要同时 COPY frontend/、backend/、deploy/），
# 下面这些用不到，且会把上下文撑大或把本机数据带进镜像。

.git/**
.gitignore
.idea/**
.vscode/**
.workbuddy/**
.tmp/**
.github/**
**/.DS_Store
**/Thumbs.db

# 前端：依赖与上一次的产物都不进上下文
frontend/node_modules/**
frontend/dist/**
frontend/dist-ssr/**
# .env.production / .env.development 是入库的公开配置（VITE_API_BASE=/api），必须保留；
# 只排除本地私有变量文件与 npm 私有源凭据
frontend/.env.local
frontend/.env.*.local
**/.npmrc

# 后端：构建产物、本机数据库、历史遗留的静态目录
backend/target/**
backend/data/**
backend/logs/**
backend/src/main/resources/static/**
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.sqlite3
**/.secret
**/*.key
**/*.pem

# 部署目录里的运行时文件；entrypoint.sh / docker-compose.yml 要保留
deploy/.env
deploy/data/**

# 文档、脚本与许可文本不参与镜像构建
docs/**
scripts/**
*.md
LICENSE

# 根级环境变量（含明文凭据的风险）
.env
.env.local
.env.*
!.env.example
# 前端构建期必需：VITE_API_BASE=/api；显式放行，避免被上面的 .env.* 误伤
!frontend/.env.production
!frontend/.env.development

*.log
